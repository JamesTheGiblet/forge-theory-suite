// ============================================================================
// CSS (Capital Siphon System) Endpoint
// ============================================================================

app.get('/api/css/events', async (req, res) => {
  try {
    const limit = Math.min(parseInt(req.query.limit) || 20, 100);
    const dbPath = path.join(__dirname, 'data', 'css-production.db');
    if (!fs.existsSync(dbPath)) {
      return res.json({ events: [] });
    }
    const SQL = await initSqlJs();
    const db = new SQL.Database(fs.readFileSync(dbPath));
    const result = db.exec(`SELECT timestamp, from_engine, to_fund, amount_usd, reason, trigger_value FROM siphon_events ORDER BY timestamp DESC LIMIT ${limit}`);
    db.close();
    if (result.length) {
      const events = result[0].values.map(row => ({
        timestamp: row[0],
        from_engine: row[1],
        to_fund: row[2],
        amount_usd: row[3],
        reason: row[4],
        trigger_value: row[5]
      }));
      res.json({ events });
    } else {
      res.json({ events: [] });
    }
  } catch (err) {
    console.error('CSS events error:', err.message);
    res.json({ events: [] });
  }
});

// ============================================================================
// AUDIT Summary Endpoint
// ============================================================================

app.get('/api/audit/summary', async (req, res) => {
  try {
    const dbPath = path.join(__dirname, 'data', 'audit-production.db');
    if (!fs.existsSync(dbPath)) {
      return res.json({ active_alerts: 0, alerts: [], timestamp: new Date().toISOString() });
    }
    const SQL = await initSqlJs();
    const db = new SQL.Database(fs.readFileSync(dbPath));
    const result = db.exec(`SELECT component, severity, message FROM audit_alerts WHERE resolved IS NULL ORDER BY last_seen DESC LIMIT 10`);
    db.close();
    if (result.length) {
      const alerts = result[0].values.map(row => `${row[0]}: ${row[2]}`);
      res.json({ active_alerts: result[0].values.length, alerts, timestamp: new Date().toISOString() });
    } else {
      res.json({ active_alerts: 0, alerts: [], timestamp: new Date().toISOString() });
    }
  } catch (err) {
    console.error('AUDIT summary error:', err.message);
    res.json({ active_alerts: 0, alerts: [], timestamp: new Date().toISOString() });
  }
});

// ============================================================================
// GUIDANCE LAYER (G.L)
// ============================================================================

let guidanceMode = 'BALANCED';
let guidanceSignal = 0.5;
let guidanceUpdated = null;

app.get('/api/guidance/current', (req, res) => {
  res.json({
    mode: guidanceMode,
    signal: guidanceSignal,
    updated: guidanceUpdated ? guidanceUpdated.toISOString() : new Date().toISOString()
  });
});

app.post('/api/guidance/set', (req, res) => {
  const { mode, signal } = req.body;
  if (mode && ['CAUTIOUS', 'BALANCED', 'AGGRESSIVE'].includes(mode)) {
    guidanceMode = mode;
    guidanceSignal = mode === 'CAUTIOUS' ? 0 : mode === 'AGGRESSIVE' ? 1 : 0.5;
  } else if (signal !== undefined && signal >= 0 && signal <= 1) {
    guidanceSignal = signal;
    if (signal <= 0.33) guidanceMode = 'CAUTIOUS';
    else if (signal <= 0.66) guidanceMode = 'BALANCED';
    else guidanceMode = 'AGGRESSIVE';
  }
  guidanceUpdated = new Date();
  console.log(`🎮 Guidance Layer updated: ${guidanceMode} (${guidanceSignal})`);
  res.json({ success: true, mode: guidanceMode, signal: guidanceSignal });
});

// ============================================================================
// WEATHER ENGINE API
// ============================================================================

let weatherSignals = [];

async function fetchWeatherSignals() {
  try {
    const WEATHER_API_KEY = process.env.WEATHER_API_KEY;
    if (!WEATHER_API_KEY) return;
    const locations = [
      { name: 'US Midwest', city: 'Chicago', commodities: ['Corn', 'Soybeans', 'Wheat'] },
      { name: 'Brazil', city: 'Sao Paulo', commodities: ['Oranges'] },
      { name: 'Southeast Asia', city: 'Bangkok', commodities: ['Rice'] },
      { name: 'California', city: 'Fresno', commodities: ['Oranges'] }
    ];
    const signals = [];
    for (const loc of locations) {
      const weatherRes = await axios.get(`https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(loc.city)}&units=metric&appid=${WEATHER_API_KEY}`);
      const forecastRes = await axios.get(`https://api.openweathermap.org/data/2.5/forecast?q=${encodeURIComponent(loc.city)}&units=metric&cnt=24&appid=${WEATHER_API_KEY}`);
      const weather = {
        temp: weatherRes.data.main.temp,
        humidity: weatherRes.data.main.humidity,
        condition: weatherRes.data.weather[0].main
      };
      const forecasts = forecastRes.data.list.filter((_, i) => i % 8 === 0).slice(0, 3);
      for (const commodity of loc.commodities) {
        let signal = 0, reason = '';
        if (commodity === 'Rice') {
          if (forecasts.some(f => f.weather[0].main === 'Rain' && f.main.temp > 25)) { signal = -0.6; reason = 'Excessive rainfall forecast'; }
          else if (weather.humidity > 80) { signal = -0.3; reason = 'High humidity'; }
          else { signal = 0.1; reason = 'Normal conditions'; }
        } else if (commodity === 'Oranges') {
          if (forecasts.some(f => f.main.temp < 0)) { signal = -0.8; reason = 'Frost forecast!'; }
          else if (weather.temp < 5) { signal = -0.4; reason = 'Cold temperatures'; }
          else if (weather.temp > 25) { signal = 0.3; reason = 'Warm weather good'; }
          else { signal = 0.1; reason = 'Normal conditions'; }
        } else if (commodity === 'Wheat') {
          if (forecasts.every(f => f.weather[0].main !== 'Rain' && f.main.humidity < 50)) { signal = -0.7; reason = 'Drought forecast'; }
          else if (weather.humidity < 40) { signal = -0.3; reason = 'Dry conditions'; }
          else { signal = 0.2; reason = 'Favorable conditions'; }
        } else if (commodity === 'Corn') {
          if (forecasts.some(f => f.main.temp > 35)) { signal = -0.5; reason = 'Extreme heat'; }
          else if (forecasts.some(f => f.main.temp > 25 && f.main.temp < 30)) { signal = 0.4; reason = 'Optimal temperature'; }
          else { signal = 0.1; reason = 'Normal'; }
        } else if (commodity === 'Soybeans') {
          if (forecasts.some(f => f.weather[0].main === 'Rain')) { signal = 0.3; reason = 'Good rainfall'; }
          else if (weather.humidity > 85) { signal = -0.3; reason = 'Excessive humidity'; }
          else { signal = 0.1; reason = 'Normal'; }
        }
        if (signal !== 0) {
          signals.push({ commodity, signal: signal, reason, location: loc.name, temp: weather.temp, condition: weather.condition, humidity: weather.humidity });
        }
      }
    }
    weatherSignals = signals;
  } catch(e) { console.error('Weather API error:', e.message); }
}

app.get('/api/weather/signals', (req, res) => {
  res.json({ signals: weatherSignals });
});

fetchWeatherSignals();
setInterval(fetchWeatherSignals, 60 * 60 * 1000);

