app.get('/api/fl/doubt', async (req, res) => {
  try {
    const dbPath = path.join(__dirname, 'data', 'fl-production.db');
    if (!fs.existsSync(dbPath)) {
      return res.json({ patterns: [] });
    }
    const SQL = await initSqlJs();
    const db = new SQL.Database(fs.readFileSync(dbPath));
    const result = db.exec(`SELECT engine, context_signature, doubt_score, count, avg_regret, last_seen FROM fl_patterns WHERE doubt_score > 0 ORDER BY doubt_score DESC LIMIT 20`);
    db.close();
    if (result.length) {
      const patterns = result[0].values.map(row => ({
        engine: row[0],
        context: row[1],
        doubt_score: row[2],
        count: row[3],
        avg_regret: row[4],
        last_seen: row[5]
      }));
      res.json({ patterns });
    } else {
      res.json({ patterns: [] });
    }
  } catch (err) {
    console.error('FL doubt error:', err.message);
    res.json({ patterns: [] });
  }
});

app.get('/api/fl/lessons', async (req, res) => {
  try {
    const limit = Math.min(parseInt(req.query.limit) || 20, 100);
    const dbPath = path.join(__dirname, 'data', 'fl-production.db');
    if (!fs.existsSync(dbPath)) {
      return res.json({ lessons: [] });
    }
    const SQL = await initSqlJs();
    const db = new SQL.Database(fs.readFileSync(dbPath));
    const result = db.exec(`SELECT trade_id, engine, timestamp, actual_pnl, regret, alternative_action FROM fl_lessons ORDER BY timestamp DESC LIMIT ${limit}`);
    db.close();
    if (result.length) {
      const lessons = result[0].values.map(row => ({
        trade_id: row[0],
        engine: row[1],
        timestamp: row[2],
        actual_pnl: row[3],
        regret: row[4],
        alternative_action: row[5]
      }));
      res.json({ lessons });
    } else {
      res.json({ lessons: [] });
    }
  } catch (err) {
    console.error('FL lessons error:', err.message);
    res.json({ lessons: [] });
  }
});

// ============================================================================
// FOREX RATE (EUR/USD) - Free API
// ============================================================================

let eurUsdRate = 1.1515;
let forexLastUpdate = null;

async function fetchEurUsd() {
  try {
    // Free API from exchangerate-api.com (no key required, limited calls)
    const response = await axios.get('https://api.exchangerate-api.com/v4/latest/EUR');
    if (response.data && response.data.rates && response.data.rates.USD) {
      eurUsdRate = response.data.rates.USD;
      console.log(`💱 EUR/USD updated: ${eurUsdRate.toFixed(4)}`);
      forexLastUpdate = new Date();
    }
  } catch (err) {
    console.log('⚠️ Forex API failed, using fallback rate:', err.message);
  }
}

app.get('/api/forex/rate', (req, res) => {
  res.json({
    eur_usd: eurUsdRate,
    timestamp: forexLastUpdate ? forexLastUpdate.toISOString() : new Date().toISOString()
  });
});

// Fetch initially and every hour
fetchEurUsd();
setInterval(fetchEurUsd, 60 * 60 * 1000);

console.log('📈 Live EUR/USD feed active');

// ============================================================================
// FRED ECONOMIC DATA (Fed Rate, Treasury Yields) - XML Parser
// ============================================================================

const FRED_API_KEY = process.env.FRED_API_KEY_1 || process.env.FRED_API_KEY_2 || '';
const xml2js = require('xml2js');

let fedRate = 3.64;
let treasury10y = 4.42;
let fredLastUpdate = null;

async function fetchFredData() {
  if (!FRED_API_KEY) {
    console.log('⚠️ No FRED API key, using fallback values');
    return;
  }

  try {
    // Fetch Fed Funds Rate (FEDFUNDS)
    const fedRes = await axios.get(`https://api.stlouisfed.org/fred/series/observations?series_id=FEDFUNDS&api_key=${FRED_API_KEY}&sort_order=desc&limit=1`);
    const fedParser = new xml2js.Parser();
    const fedResult = await fedParser.parseStringPromise(fedRes.data);
    if (fedResult.observations && fedResult.observations.observation && fedResult.observations.observation[0]) {
      const rate = parseFloat(fedResult.observations.observation[0].$.value);
      if (!isNaN(rate)) {
        fedRate = rate;
        console.log(`🏦 Fed Funds Rate updated: ${fedRate}%`);
      }
    }

    // Fetch 10-Year Treasury Yield (DGS10)
    const treasRes = await axios.get(`https://api.stlouisfed.org/fred/series/observations?series_id=DGS10&api_key=${FRED_API_KEY}&sort_order=desc&limit=1`);
    const treasParser = new xml2js.Parser();
    const treasResult = await treasParser.parseStringPromise(treasRes.data);
    if (treasResult.observations && treasResult.observations.observation && treasResult.observations.observation[0]) {
      const yield10 = parseFloat(treasResult.observations.observation[0].$.value);
      if (!isNaN(yield10)) {
        treasury10y = yield10;
        console.log(`📈 10-Year Treasury updated: ${treasury10y}%`);
      }
    }

    fredLastUpdate = new Date();
  } catch (err) {
    console.error('❌ Failed to fetch FRED data:', err.message);
  }
}

app.get('/api/fred/status', (req, res) => {
  res.json({
    fed_rate: fedRate,
    treasury_10y: treasury10y,
    timestamp: fredLastUpdate ? fredLastUpdate.toISOString() : new Date().toISOString()
  });
});

// Fetch initially and every 6 hours (FRED updates daily)
fetchFredData();
setInterval(fetchFredData, 6 * 60 * 60 * 1000);

console.log('📈 Live FRED economic data feed active');

// ============================================================================
// G.O (Grand Orchestrator) Endpoint
// ============================================================================

app.get('/api/go/status', async (req, res) => {
  try {
    const dbPath = path.join(__dirname, 'data', 'go-production.db');
    if (!fs.existsSync(dbPath)) {
      return res.json({ regime: 'NEUTRAL', stability: 0, status: 'LEARNING' });
    }
    const SQL = await initSqlJs();
    const db = new SQL.Database(fs.readFileSync(dbPath));
    const result = db.exec(`SELECT regime_label, stability_score, status FROM go_cycles ORDER BY timestamp DESC LIMIT 1`);
    db.close();
    if (result.length && result[0].values.length) {
      const row = result[0].values[0];
      res.json({
        regime: row[0],
        stability: row[1],
        status: row[2]
      });
    } else {
      res.json({ regime: 'NEUTRAL', stability: 0, status: 'LEARNING' });
    }
  } catch (err) {
    console.error('G.O endpoint error:', err.message);
    res.json({ regime: 'NEUTRAL', stability: 0, status: 'LEARNING' });
  }
});

