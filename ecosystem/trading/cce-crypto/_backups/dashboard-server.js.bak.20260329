app.get('/api/observer/status', (req, res) => {
  try {
    const dbPath = path.join(__dirname, 'data', 'obs-production.db');
    if (!fs.existsSync(dbPath)) return res.json({ observations: 0, patterns: 0, anomalies: 0 });
    initSqlJs().then(SQL => {
      const db = new SQL.Database(fs.readFileSync(dbPath));
      const r = db.exec('SELECT COUNT(*) FROM observations');
      const p = db.exec('SELECT COUNT(*) FROM patterns');
      db.close();
      const observations = r[0]?.values[0][0] || 0;
      const patterns = p[0]?.values[0][0] || 0;
      res.json({ observations, patterns, anomalies: 0 });
    }).catch(() => res.json({ observations: 0, patterns: 0, anomalies: 0 }));
  } catch(e) { res.json({ observations: 0, patterns: 0, anomalies: 0 }); }
});

