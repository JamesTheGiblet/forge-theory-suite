app.get('/api/status', (req, res) => {
  try {
    const dbPath = path.join(__dirname, 'data', 'cce-production.db');
    if (!fs.existsSync(dbPath)) return res.json({ btc_price: 0, fear_greed: 0, btc_dominance: 0, timestamp: new Date().toISOString() });
    initSqlJs().then(SQL => {
      const db = new SQL.Database(fs.readFileSync(dbPath));
      const r = db.exec('SELECT btc_price, fear_greed, btc_dominance, current_state, portfolio_value, timestamp FROM cce_cycles ORDER BY id DESC LIMIT 1');
      db.close();
      if (!r[0]) return res.json({ btc_price: 0, fear_greed: 0, btc_dominance: 0, timestamp: new Date().toISOString() });
      const [btc_price, fear_greed, btc_dominance, current_state, portfolio_value, timestamp] = r[0].values[0];
      res.json({ btc_price, fear_greed, btc_dominance, current_state, portfolio_value, timestamp });
    }).catch(e => res.json({ error: e.message }));
  } catch(e) { res.json({ error: e.message }); }
});

app.get('/api/grid/status', (req, res) => {
  try {
    const dbPath = path.join(__dirname, 'data', 'grid-production.db');
    if (!fs.existsSync(dbPath)) return res.json({ state: 'DORMANT', profit: 0 });
    initSqlJs().then(SQL => {
      const db = new SQL.Database(fs.readFileSync(dbPath));
      const r = db.exec('SELECT grid_state, total_profit, open_buys, open_sells, completed_cycles, btc_price, centre_price, portfolio_value FROM grid_cycles ORDER BY id DESC LIMIT 1');
      db.close();
      if (!r[0]) return res.json({ state: 'DORMANT', profit: 0 });
      const [grid_state, total_profit, open_buys, open_sells, completed_cycles, btc_price, centre_price, portfolio_value] = r[0].values[0];
      res.json({ state: grid_state, profit: total_profit, open_buys, open_sells, cycles: completed_cycles, btc_price, centre_price, portfolio_value });
    }).catch(() => res.json({ state: 'DORMANT', profit: 0 }));
  } catch(e) { res.json({ state: 'DORMANT', profit: 0 }); }
});

