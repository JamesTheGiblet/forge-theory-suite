// ============================================================================
// PORTFOLIO TRACKER
// ============================================================================

const KrakenClient = require('kraken-api');
const kraken = new KrakenClient(
  process.env.KRAKEN_API_KEY,
  process.env.KRAKEN_API_SECRET
);

async function getPortfolio() {
  try {
    const balance = await kraken.api('Balance');
    const ticker = await kraken.api('Ticker', { pair: 'XBTUSD' });
    const btcPrice = parseFloat(ticker.result.XXBTZUSD.c[0]);
    const ethTicker = await kraken.api('Ticker', { pair: 'ETHUSD' });
    const ethPrice = parseFloat(ethTicker.result.XETHZUSD.c[0]);
    const solTicker = await kraken.api('Ticker', { pair: 'SOLUSD' });
    const solPrice = parseFloat(solTicker.result.SOLUSD.c[0]);

    const assets = [];
    let totalUSD = 0;

    for (const [asset, amount] of Object.entries(balance.result)) {
      const numAmount = parseFloat(amount);
      if (numAmount === 0) continue;

      let usdValue = 0;
      let price = 0;

      if (asset === 'USDC' || asset === 'USD') {
        usdValue = numAmount;
        price = 1;
      } else if (asset === 'XXBT' || asset === 'XBT') {
        usdValue = numAmount * btcPrice;
        price = btcPrice;
      } else if (asset === 'XETH') {
        usdValue = numAmount * ethPrice;
        price = ethPrice;
      } else if (asset === 'SOL') {
        usdValue = numAmount * solPrice;
        price = solPrice;
      } else {
        continue;
      }

      totalUSD += usdValue;
      assets.push({
        symbol: asset === 'XXBT' ? 'BTC' : asset === 'XETH' ? 'ETH' : asset,
        amount: numAmount,
        usdValue,
        price,
        percentage: 0
      });
    }

    assets.forEach(asset => {
      asset.percentage = totalUSD > 0 ? (asset.usdValue / totalUSD) * 100 : 0;
    });

    return {
      totalUSD,
      assets: assets.sort((a, b) => b.usdValue - a.usdValue),
      timestamp: new Date().toISOString()
    };
  } catch (err) {
    console.error('Portfolio fetch error:', err.message);
    return { totalUSD: 0, assets: [], error: err.message, timestamp: new Date().toISOString() };
  }
}

app.get('/api/portfolio', async (req, res) => {
  const portfolio = await getPortfolio();
  res.json(portfolio);
});

app.get('/api/portfolio/summary', async (req, res) => {
  const portfolio = await getPortfolio();
  res.json({
    total: portfolio.totalUSD,
    assetCount: portfolio.assets.length,
    topAsset: portfolio.assets[0]?.symbol || 'None',
    topValue: portfolio.assets[0]?.usdValue || 0,
    timestamp: portfolio.timestamp
  });
});

// ============================================================================
// COMMODITIES (gold live via MetalpriceAPI, oil live from database)
// ============================================================================

const METALPRICE_KEY = process.env.METALPRICE_API_KEY;

let oilPrice = 98.23;
let goldPrice = 4575;
let commodityLastUpdate = null;

// Fetch live gold from MetalpriceAPI
async function fetchGold() {
  if (!METALPRICE_KEY) {
    console.log("⚠️ No MetalpriceAPI key, gold remains static");
    return;
  }

  try {
    const res = await axios.get(`https://api.metalpriceapi.com/v1/latest?api_key=${METALPRICE_KEY}&base=USD&currencies=XAU`);
    if (res.data && res.data.success && res.data.rates && res.data.rates.USDXAU) {
      goldPrice = parseFloat(res.data.rates.USDXAU);
      console.log(`🥇 Gold price updated: $${goldPrice}`);
    } else {
      console.log("⚠️ Gold API returned unexpected format");
    }
  } catch (err) {
    console.error("❌ Failed to fetch gold:", err.message);
  }
}

// Fetch live oil from como-production.db
async function fetchOil() {
  try {
    const dbPath = path.join(__dirname, 'data', 'como-production.db');
    if (!fs.existsSync(dbPath)) {
      console.log("⚠️ Oil database not found");
      return;
    }
    const SQL = await initSqlJs();
    const db = new SQL.Database(fs.readFileSync(dbPath));
    const result = db.exec('SELECT oil_price FROM como_cycles ORDER BY timestamp DESC LIMIT 1');
    db.close();
    if (result.length && result[0].values.length) {
      const latestOil = result[0].values[0][0];
      if (latestOil !== null && latestOil !== undefined) {
        oilPrice = latestOil;
        console.log(`🛢️  Oil price updated: $${oilPrice}`);
      }
    }
  } catch (err) {
    console.error("❌ Failed to fetch oil from database:", err.message);
  }
}

// Combined update function
async function fetchCommodityPrices() {
  await fetchGold();
  await fetchOil();
  commodityLastUpdate = new Date();
}

// Endpoint
app.get("/api/como/status", (req, res) => {
  res.json({
    oil_price: oilPrice,
    gold_price: goldPrice,
    timestamp: commodityLastUpdate ? commodityLastUpdate.toISOString() : new Date().toISOString()
  });
});

// Fetch initially and every hour
fetchCommodityPrices();
setInterval(fetchCommodityPrices, 60 * 60 * 1000);

console.log("📈 Live commodities feed active (gold via MetalpriceAPI, oil from database)");

