const ALPHA_VANTAGE_KEY = process.env.ALPHA_VANTAGE_API_KEY || process.env.ALPHA_VANTAGE_KEY || '';

let reitPrice = 60.95;
let reitLastUpdate = null;

async function fetchReitPrice() {
  if (!ALPHA_VANTAGE_KEY) {
    console.log('⚠️ No Alpha Vantage key, using fallback REIT price');
    return;
  }
  try {
    const response = await axios.get(`https://www.alphavantage.co/query?function=GLOBAL_QUOTE&symbol=O&apikey=${ALPHA_VANTAGE_KEY}`);
    if (response.data && response.data['Global Quote'] && response.data['Global Quote']['05. price']) {
      const price = parseFloat(response.data['Global Quote']['05. price']);
      if (!isNaN(price)) {
        reitPrice = price;
        console.log(`🏢 O Realty price updated: $${reitPrice}`);
        reitLastUpdate = new Date();
      }
    }
  } catch (err) {
    console.log('⚠️ REIT price fetch failed:', err.message);
  }
}

app.get('/api/reit/price', (req, res) => {
  res.json({
    price: reitPrice,
    timestamp: reitLastUpdate ? reitLastUpdate.toISOString() : new Date().toISOString()
  });
});

fetchReitPrice();
