app.get('/api/export/csv', async (req, res) => {
  try {
    const dbPath = path.join(__dirname, 'data', 'cce-production.db');
    let btcPrice = 67844;
    let fearGreed = 13;
    let btcDominance = 56.24;
    let portfolioValue = 291.7;
    let currentState = 'DORMANT';
    let dbTimestamp = new Date().toISOString();

    if (fs.existsSync(dbPath)) {
        const SQL = await initSqlJs();
      const db = new SQL.Database(fs.readFileSync(dbPath));
      const result = db.exec('SELECT timestamp, btc_price, fear_greed, btc_dominance, portfolio_value, current_state FROM cce_cycles ORDER BY timestamp DESC LIMIT 1');
      if (result.length && result[0].values.length) {
        const row = result[0].values[0];
        dbTimestamp = row[0] || new Date().toISOString();
        btcPrice = row[1] || 67844;
        fearGreed = row[2] || 13;
        btcDominance = row[3] || 56.24;
        portfolioValue = row[4] || 291.7;
        currentState = row[5] || 'DORMANT';
      }
      db.close();
    }

    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
    const csvRows = [
      ['CCE Dashboard Export', timestamp],
      [''],
      ['METRIC', 'VALUE', 'TIMESTAMP'],
      ['BTC Price', btcPrice, dbTimestamp],
      ['Fear & Greed', fearGreed, dbTimestamp],
      ['BTC Dominance', btcDominance, dbTimestamp],
      ['Portfolio Value', portfolioValue, dbTimestamp],
      ['Current State', currentState, dbTimestamp]
    ];

    const csvContent = csvRows.map(row => row.join(',')).join('\n');
    res.setHeader('Content-Disposition', `attachment; filename="cce-export-${timestamp}.csv"`);
    res.setHeader('Content-Type', 'text/csv');
    res.send(csvContent);
  } catch (err) {
    console.error('Export error:', err);
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
    res.send(`CCE Dashboard Export,${timestamp}\n\nMETRIC,VALUE,TIMESTAMP\nBTC Price,67844,${new Date().toISOString()}\nFear & Greed,13,${new Date().toISOString()}\nBTC Dominance,56.24,${new Date().toISOString()}`);
  }
});

app.get('/api/export/history', async (req, res) => {
  try {
    const limit = Math.min(parseInt(req.query.limit) || 100, 5000);
    const dbPath = path.join(__dirname, 'data', 'cce-production.db');
    let history = [];

    if (fs.existsSync(dbPath)) {
        const SQL = await initSqlJs();
      const db = new SQL.Database(fs.readFileSync(dbPath));
      const result = db.exec(`SELECT timestamp, btc_price, fear_greed, btc_dominance, portfolio_value, current_state FROM cce_cycles ORDER BY timestamp DESC LIMIT ${limit}`);
      if (result.length) {
        const { columns, values } = result[0];
        history = values.map(row => {
          const obj = {};
          columns.forEach((col, i) => obj[col] = row[i]);
          return obj;
        });
      }
      db.close();
    }

    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
    const csvRows = [
      ['CCE History Export', timestamp],
      [''],
      ['TIMESTAMP', 'BTC_PRICE', 'FEAR_GREED', 'BTC_DOMINANCE', 'PORTFOLIO_VALUE', 'STATE']
    ];

    if (history && history.length) {
      history.forEach(h => {
        csvRows.push([
          h.timestamp || 'N/A',
          h.btc_price || 'N/A',
          h.fear_greed || 'N/A',
          h.btc_dominance || 'N/A',
          h.portfolio_value || 'N/A',
          h.current_state || 'N/A'
        ]);
      });
    }

    const csvContent = csvRows.map(row => row.join(',')).join('\n');
    res.setHeader('Content-Disposition', `attachment; filename="cce-history-${timestamp}.csv"`);
    res.setHeader('Content-Type', 'text/csv');
    res.send(csvContent);
  } catch (err) {
    console.error('History export error:', err);
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
    res.send(`CCE History Export,${timestamp}\n\nTIMESTAMP,BTC_PRICE,FEAR_GREED,BTC_DOMINANCE,STATE\n${new Date().toISOString()},67844,13,56.24,DORMANT`);
  }
});

// ============================================================================
// TELEGRAM ENDPOINTS
// ============================================================================

function sendTelegramMessage(message) {
  return new Promise((resolve) => {
    if (!TELEGRAM_BOT_TOKEN || !TELEGRAM_CHAT_ID) {
      console.log('⚠️ Telegram not configured');
      resolve(false);
      return;
    }
    const https = require('https');
    const postData = JSON.stringify({ chat_id: TELEGRAM_CHAT_ID, text: message, parse_mode: 'HTML' });
    const req = https.request(
      `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`,
      { method: 'POST', headers: { 'Content-Type': 'application/json' } },
      (res) => {
        let data = '';
        res.on('data', chunk => data += chunk);
        res.on('end', () => {
          try {
            const json = JSON.parse(data);
            if (json.ok) {
              console.log('✅ Telegram message sent');
              resolve(true);
            } else {
              console.log('❌ Telegram error:', json.description);
              resolve(false);
            }
          } catch(e) { resolve(false); }
        });
      }
    );
    req.on('error', (e) => { console.log('❌ Telegram error:', e.message); resolve(false); });
    req.write(postData);
    req.end();
  });
}

app.get('/api/telegram/ping', (req, res) => {
  res.json({ hasToken: !!TELEGRAM_BOT_TOKEN, tokenLength: TELEGRAM_BOT_TOKEN.length, hasChat: !!TELEGRAM_CHAT_ID });
});

app.post('/api/telegram/send', async (req, res) => {
  const message = req.body.message || '🔔 Test from CCE';
  const result = await sendTelegramMessage(message);
  if (result) res.json({ success: true, message: 'Sent!' });
  else res.status(500).json({ error: 'Failed' });
});

app.post('/api/telegram/test', async (req, res) => {
  const result = await sendTelegramMessage('🔔 Test from CCE Dashboard button!');
  if (result) res.json({ success: true, message: 'Test sent!' });
  else res.status(500).json({ error: 'Failed' });
});

