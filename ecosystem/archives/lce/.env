# LCE — Liquidation Cascade Engine
# Copy to .env and fill in your values

# ── Mode ────────────────────────────────────────────────────
DRY_RUN=true                        # false = live trading
PAPER_BALANCE=1000                  # Starting paper balance ($)

# ── Coinglass (optional — Binance fallback if missing) ──────
COINGLASS_API_KEY=your_key_here     # Free tier at coinglass.com

# ── Kraken (only needed for live trading) ───────────────────
KRAKEN_API_KEY=your_key_here
KRAKEN_SECRET=your_secret_here

# ── Telegram notifications ───────────────────────────────────
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Storage ──────────────────────────────────────────────────
LCE_DB_PATH=./lce.db

# ── Dashboard ────────────────────────────────────────────────
LCE_PORT=3004
