{
  "scp_version": "0.1",
  "scp_id": "system/dashboard",
  "object_class": "Thaumiel",
  "intent": "Render the global UBVM HTML dashboard with BuddAI and LEGION stats every minute.",
  "containment": {
    "read_only": false,
    "audit_log": false,
    "kill_switch": false
  },
  "behaviours": [
    {
      "trigger": "cron",
      "schedule": "* * * * *",
      "actions": [
        {
          "primitive": "retrieve_memory",
          "params": {
            "max_memories": 1
          }
        },
        {
          "primitive": "read_file",
          "params": {
            "path": "strategies/selected/current_best.json"
          }
        },
        {
          "primitive": "render.component",
          "params": {
            "title": "UBVM Organism Core",
            "content": "System Status: Nominal\nData Cube: Connected\n\n[ LATEST BUDDAI THOUGHT ]\n$results.0.memories.0.thought\n\n[ CURRENT BEST LEGION STRATEGY ]\n$results.1.content",
            "path": "logs/dashboard.html"
          }
        }
      ]
    }
  ]
}