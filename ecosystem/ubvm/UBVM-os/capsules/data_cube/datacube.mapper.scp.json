{
  "scp_version": "0.1",
  "scp_id": "datacube/mapper",
  "object_class": "Euclid",
  "intent": "Listen for consolidated memories and map them into the Data Cube using semantic dimensions.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": false
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event": "datacube.memory.consolidated",
      "actions": [
        {
          "primitive": "map_to_cube",
          "params": {
            "core_memory_path": "$context.event.payload.core_memory_path"
          }
        },
        {
          "primitive": "log",
          "params": {
            "message": "DataCube: Mapped core memory to dimensions: $results.0.dimensions"
          }
        }
      ]
    }
  ]
}