{
  "scp_version":  "0.1",
  "scp_id":       "buddai/memory-consolidation",
  "object_class": "Thaumiel",
  "intent":       "Nightly: run the memory decay cycle, promote strong memories to long term, archive weak memories, and store a consolidation insight.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-06T00:00:00Z",
    "version":      "1.0.0",
    "context":      "BuddAI nightly memory consolidation. Forge Theory exponential decay. Short term → long term promotion.",
    "capture_mode": "conversation",
    "lineage":      ["buddai/learning", "buddai/behaviour"]
  },
  "behaviours": [
    {
      "trigger":  "cron",
      "schedule": "0 2 * * *",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "BuddAI: nightly memory consolidation starting..." }
        },
        {
          "primitive": "memory_status",
          "params":    {}
        },
        {
          "primitive": "consolidate_memory",
          "params": {
            "min_cluster_size": 2
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event":   "buddai.memory.consolidated",
            "payload": { "source": "buddai/memory-consolidation" }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "BuddAI: memory consolidation complete." }
        }
      ]
    },
    {
      "trigger": "on_load",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "BuddAI: memory-consolidation capsule loaded — nightly decay active at 02:00." }
        }
      ]
    }
  ]
}
