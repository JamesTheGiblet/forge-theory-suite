{
  "scp_version": "0.1",
  "scp_id": "buddai/telegram",
  "object_class": "Safe",
  "intent": "Listen for BuddAI thoughts and broadcast them to a Telegram chat.",
  "containment": {
    "read_only": true,
    "audit_log": true,
    "kill_switch": false
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event": "buddai.thought.generated",
      "actions": [
        {
          "primitive": "render_template",
          "params": {
            "template": "https://api.telegram.org/bot${token}/sendMessage",
            "variables": {
              "token": "$context.env.UBVM_TELEGRAM_BOT_TOKEN"
            }
          }
        },
        {
          "primitive": "render_template",
          "params": {
            "template": "BuddAI: ${thought}",
            "variables": {
              "thought": "$context.event.payload.thought"
            }
          }
        },
        {
          "primitive": "http_request",
          "params": {
            "method": "POST",
            "url": "$results.0.output",
            "data": {
              "chat_id": "$context.env.UBVM_TELEGRAM_CHAT_ID",
              "text": "$results.1.output"
            }
          }
        },
        {
          "primitive": "log",
          "params": {
            "message": "Sent thought to Telegram."
          }
        }
      ]
    }
  ]
}