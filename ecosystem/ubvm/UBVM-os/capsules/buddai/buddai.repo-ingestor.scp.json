{
  "scp_version":  "0.1",
  "scp_id":       "buddai/repo-ingestor",
  "object_class": "Safe",
  "intent":       "Weekly: fetch James's public GitHub repos and store their README files and metadata so BuddAI can learn his code style, language patterns, and project history.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-05T00:00:00Z",
    "version":      "1.0.0",
    "context":      "BuddAI repo ingestion — learns from JamesTheGiblet GitHub repos weekly.",
    "capture_mode": "conversation",
    "lineage":      ["buddai/james-identity"]
  },
  "behaviours": [
    {
      "trigger":  "cron",
      "schedule": "0 6 * * 1",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "BuddAI: ingesting GitHub repos for JamesTheGiblet..." }
        },
        {
          "primitive": "fetch_repos",
          "params": {
            "username":  "JamesTheGiblet",
            "max_repos": 20
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event":   "buddai.repos.updated",
            "payload": { "source": "buddai/repo-ingestor", "username": "JamesTheGiblet" }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "BuddAI: repo ingestion complete." }
        }
      ]
    },
    {
      "trigger": "on_load",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "BuddAI: repo-ingestor loaded — will fetch repos weekly on Monday 06:00." }
        }
      ]
    }
  ]
}