{
  "scp_version": "0.1",
  "scp_id": "legion/market-watcher",
  "object_class": "Safe",
  "intent": "Fetch live OHLCV data every 5 minutes and emit a market update event.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": true
  },
  "provenance": {
    "author": "James / Giblets Creations",
    "created_at": "2026-05-05T17:40:00Z",
    "version": "1.0.0",
    "context": "Created as part of the Phase 1 strategy loop.",
    "capture_mode": "manual"
  },
  "behaviours": [
    {
      "trigger": "cron",
      "schedule": "*/5 * * * *",
      "actions": [
        {
          "primitive": "fetch_ohlcv",
          "params": {
            "symbol": "BTCUSDT",
            "interval": "5m",
            "limit": 1000
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event": "market.data.updated",
            "payload": { "symbol": "BTCUSDT", "interval": "5m" }
          }
        }
      ]
    }
  ]
}