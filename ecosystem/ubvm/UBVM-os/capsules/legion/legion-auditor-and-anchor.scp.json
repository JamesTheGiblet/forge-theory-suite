{
  "scp_version": "0.1",
  "scp_id": "legion/auditor-and-anchor",
  "object_class": "Safe",
  "intent": "Audit system state and anchor the best strategy to maintain immutable historical snapshots.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": false
  },
  "provenance": {
    "author": "James / Giblets Creations",
    "created_at": "2026-05-05T20:35:00Z",
    "version": "1.0.0",
    "context": "Phase 2 AuditorAndAnchor capsule.",
    "capture_mode": "manual"
  },
  "behaviours": [
    {
      "trigger": "cron",
      "schedule": "0 0 * * *",
      "actions": [
        {
          "primitive": "anchor_strategy",
          "params": {
            "note": "Daily cron anchor."
          }
        }
      ]
    },
    {
      "trigger": "on_event",
      "event": "strategy.selected",
      "actions": [
        {
          "primitive": "audit_event",
          "params": {
            "event_type": "strategy.selected",
            "data": {
              "strategy_name": "$context.event.payload.strategy_name",
              "fitness_score": "$context.event.payload.fitness_score"
            }
          }
        },
        {
          "primitive": "anchor_strategy",
          "params": {
            "note": "Anchored upon new strategy selection."
          }
        }
      ]
    }
  ]
}