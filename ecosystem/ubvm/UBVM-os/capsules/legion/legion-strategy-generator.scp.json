{
  "scp_version": "0.1",
  "scp_id": "legion/strategy-generator",
  "object_class": "Euclid",
  "intent": "Generate a new base trading strategy daily and emit a strategy.generated event.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": true
  },
  "provenance": {
    "author": "James / Giblets Creations",
    "created_at": "2026-05-05T18:00:00Z",
    "version": "1.0.0",
    "context": "Created to kick off the Phase 1 strategy loop.",
    "capture_mode": "manual"
  },
  "behaviours": [
    {
      "trigger": "cron",
      "schedule": "0 0 * * *",
      "actions": [
        {
          "primitive": "strategy_generate",
          "params": {}
        },
        {
          "primitive": "emit_event",
          "params": {
            "event": "strategy.generated",
            "payload": {
              "strategy_path": "$results.0.output_path",
              "strategy_name": "$results.0.strategy_name"
            }
          }
        }
      ]
    }
  ]
}