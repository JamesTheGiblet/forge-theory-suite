{
  "scp_version": "0.1",
  "scp_id": "legion/backtester",
  "object_class": "Euclid",
  "intent": "On new strategy generation, split the latest market data and run an in-sample backtest, then emit the results.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": true
  },
  "provenance": {
    "author": "James / Giblets Creations",
    "created_at": "2026-05-05T19:00:00Z",
    "version": "1.0.0",
    "context": "Part of the Phase 1 strategy loop. Chains from StrategyGenerator.",
    "capture_mode": "manual"
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event": "strategy.generated",
      "actions": [
        {
          "primitive": "split_data",
          "params": {
            "input_path": "data/btcusdt_5m.csv"
          }
        },
        {
          "primitive": "backtest",
          "params": {
            "strategy": "$context.event.payload.strategy_path",
            "data_path": "data/train.csv"
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event": "backtest.complete",
            "payload": {
              "strategy_path": "$context.event.payload.strategy_path",
              "strategy_name": "$results.1.strategy_name",
              "backtest_metrics": "$results.1.metrics"
            }
          }
        }
      ]
    }
  ]
}