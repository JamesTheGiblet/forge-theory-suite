{
  "scp_version": "0.1",
  "scp_id": "legion/deploy-dist-worker",
  "object_class": "Safe",
  "intent": "Deploy the distributed worker capsule to a secondary UBVM node.",
  "containment": {
    "read_only": true,
    "audit_log": true,
    "kill_switch": false
  },
  "behaviours": [
    {
      "trigger": "manual",
      "actions": [
        {
          "primitive": "transmit_capsule",
          "params": {
            "target_url": "http://127.0.0.1:8081",
            "capsule_path": "capsules/legion-dist-worker.scp.json"
          }
        },
        {
          "primitive": "log",
          "params": {
            "message": "Successfully deployed dist-worker capsule to secondary node."
          }
        }
      ]
    }
  ]
}