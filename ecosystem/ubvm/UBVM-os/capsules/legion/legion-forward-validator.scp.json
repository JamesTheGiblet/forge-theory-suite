{
  "scp_version": "0.1",
  "scp_id": "legion/forward-validator",
  "object_class": "Euclid",
  "intent": "Run out-of-sample forward validation on a completed backtest and emit the validation metrics.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": true
  },
  "provenance": {
    "author": "James / Giblets Creations",
    "created_at": "2026-05-05T19:15:00Z",
    "version": "1.0.0",
    "context": "Part of the Phase 1 strategy loop. Chains from Backtester.",
    "capture_mode": "manual"
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event": "backtest.complete",
      "actions": [
        {
          "primitive": "forward_validate",
          "params": {
            "strategy": "$context.event.payload.strategy_path",
            "data_path": "data/test.csv",
            "backtest_metrics": "$context.event.payload.backtest_metrics"
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event": "validation.complete",
            "payload": {
              "strategy_name": "$results.0.strategy_name",
              "fitness_score": "$results.0.fitness_score",
              "validation_path": "$results.0.output_path"
            }
          }
        }
      ]
    }
  ]
}