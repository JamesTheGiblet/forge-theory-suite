{
  "scp_version": "0.1",
  "scp_id": "legion/risk-governor",
  "object_class": "Thaumiel",
  "intent": "Monitor live trading activity and engage the kill switch if risk limits (max drawdown, daily loss) are breached.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": false
  },
  "provenance": {
    "author": "James / Giblets Creations",
    "created_at": "2026-05-05T22:05:00Z",
    "version": "1.0.0",
    "context": "Phase 4 Risk Governor capsule.",
    "capture_mode": "manual"
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event": "live_order_placed",
      "actions": [
        {
          "primitive": "evaluate_risk",
          "params": {}
        }
      ]
    },
    {
      "trigger": "on_event",
      "event": "risk.breached",
      "actions": [
        {
          "primitive": "emit_event",
          "params": { "event": "trading.stop", "payload": {"reason": "risk_limits_breached"} }
        }
      ]
    }
  ]
}