{
  "scp_version": "0.1",
  "scp_id": "legion/stop-trading",
  "object_class": "Thaumiel",
  "intent": "Listen for system errors or stop trading events and engage the kill switch.",
  "containment": {
    "read_only": false,
    "audit_log": true,
    "kill_switch": false
  },
  "provenance": {
    "author": "James / Giblets Creations",
    "created_at": "2026-05-05T21:05:00Z",
    "version": "1.0.0",
    "context": "Phase 3 StopTrading capsule.",
    "capture_mode": "manual"
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event": "system.error",
      "actions": [
        {
          "primitive": "log",
          "params": { "level": "error", "message": "System error detected. Engaging kill switch." }
        },
        {
          "primitive": "write_file",
          "params": { "path": "data/kill_switch.flag", "content": "1" }
        }
      ]
    },
    {
      "trigger": "on_event",
      "event": "trading.stop",
      "actions": [
        {
          "primitive": "log",
          "params": { "level": "warn", "message": "Trading stop event received. Engaging kill switch." }
        },
        {
          "primitive": "write_file",
          "params": { "path": "data/kill_switch.flag", "content": "1" }
        }
      ]
    }
  ]
}