{
  "scp_version":  "0.1",
  "scp_id":       "legion/mutator",
  "object_class": "Keter",
  "intent":       "Weekly: take the current best strategy, generate 3 mutated offspring, and restart the evaluation pipeline.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-05T13:00:00Z",
    "version":      "1.0.0",
    "context":      "Phase 2 trading OS — evolutionary mutation capsule. Keter because it generates new strategies that will govern live trading.",
    "capture_mode": "conversation",
    "lineage":      ["legion/strategy-selector"]
  },
  "behaviours": [
    {
      "trigger":  "cron",
      "schedule": "0 0 * * 1",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "Mutator: generating offspring from current best strategy..." }
        },
        {
          "primitive": "audit_event",
          "params": {
            "event_type": "mutation.started",
            "data":       { "source": "legion/mutator", "schedule": "weekly" }
          }
        },
        {
          "primitive": "mutate_strategy",
          "params": {
            "n_offspring": 3,
            "magnitude":   0.1
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event":   "strategy.generated",
            "payload": { "source": "legion/mutator", "type": "mutation" }
          }
        },
        {
          "primitive": "audit_event",
          "params": {
            "event_type": "mutation.complete",
            "data":       { "n_offspring": 3, "source": "legion/mutator" }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "Mutator: 3 offspring generated, strategy.generated emitted." }
        }
      ]
    }
  ]
}
