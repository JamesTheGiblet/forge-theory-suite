{
  "scp_version":  "0.1",
  "scp_id":       "legion/strategy-generator",
  "object_class": "Euclid",
  "intent":       "Generate candidate trading strategies daily and save them to the raw strategies directory for backtesting.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-05T12:00:00Z",
    "version":      "1.0.0",
    "context":      "Phase 1 trading OS — strategy generation capsule.",
    "capture_mode": "conversation",
    "lineage":      []
  },
  "behaviours": [
    {
      "trigger":  "cron",
      "schedule": "0 0 * * *",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "StrategyGenerator: generating candidate strategies..." }
        },
        {
          "primitive": "write_file",
          "params": {
            "path":    "strategies/raw/sma_10_30.json",
            "content": "{\"name\": \"sma_10_30\", \"type\": \"crossover\", \"params\": {\"fast\": 10, \"slow\": 30}}"
          }
        },
        {
          "primitive": "write_file",
          "params": {
            "path":    "strategies/raw/sma_5_20.json",
            "content": "{\"name\": \"sma_5_20\", \"type\": \"crossover\", \"params\": {\"fast\": 5, \"slow\": 20}}"
          }
        },
        {
          "primitive": "write_file",
          "params": {
            "path":    "strategies/raw/sma_20_50.json",
            "content": "{\"name\": \"sma_20_50\", \"type\": \"crossover\", \"params\": {\"fast\": 20, \"slow\": 50}}"
          }
        },
        {
          "primitive": "write_file",
          "params": {
            "path":    "strategies/raw/rsi_14.json",
            "content": "{\"name\": \"rsi_14\", \"type\": \"rsi\", \"params\": {\"period\": 14, \"oversold\": 30, \"overbought\": 70}}"
          }
        },
        {
          "primitive": "write_file",
          "params": {
            "path":    "strategies/raw/rsi_10.json",
            "content": "{\"name\": \"rsi_10\", \"type\": \"rsi\", \"params\": {\"period\": 10, \"oversold\": 25, \"overbought\": 75}}"
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event":   "strategy.generated",
            "payload": { "count": 5, "dir": "strategies/raw/" }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "StrategyGenerator: 5 strategies written, strategy.generated emitted." }
        }
      ]
    }
  ]
}
