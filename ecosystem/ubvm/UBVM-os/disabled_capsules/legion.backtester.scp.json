{
  "scp_version":  "0.1",
  "scp_id":       "legion/backtester",
  "object_class": "Euclid",
  "intent":       "On strategy.generated event, split market data and run backtest on all raw strategies, emitting backtest.complete when done.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-05T12:00:00Z",
    "version":      "1.0.0",
    "context":      "Phase 1 trading OS — backtesting capsule.",
    "capture_mode": "conversation",
    "lineage":      []
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event":   "strategy.generated",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "Backtester: splitting data and running backtests..." }
        },
        {
          "primitive": "split_data",
          "params": {
            "input_path": "data/btcusdt_1h.csv",
            "train_path": "data/train.csv",
            "test_path":  "data/test.csv",
            "ratio":      0.8
          }
        },
        {
          "primitive": "backtest",
          "params": {
            "data_path": "data/train.csv",
            "strategy":  { "name": "sma_10_30", "type": "crossover", "params": { "fast": 10, "slow": 30 } }
          }
        },
        {
          "primitive": "backtest",
          "params": {
            "data_path": "data/train.csv",
            "strategy":  { "name": "sma_5_20", "type": "crossover", "params": { "fast": 5, "slow": 20 } }
          }
        },
        {
          "primitive": "backtest",
          "params": {
            "data_path": "data/train.csv",
            "strategy":  { "name": "sma_20_50", "type": "crossover", "params": { "fast": 20, "slow": 50 } }
          }
        },
        {
          "primitive": "backtest",
          "params": {
            "data_path": "data/train.csv",
            "strategy":  { "name": "rsi_14", "type": "rsi", "params": { "period": 14, "oversold": 30, "overbought": 70 } }
          }
        },
        {
          "primitive": "backtest",
          "params": {
            "data_path": "data/train.csv",
            "strategy":  { "name": "rsi_10", "type": "rsi", "params": { "period": 10, "oversold": 25, "overbought": 75 } }
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event":   "backtest.complete",
            "payload": { "strategies": ["sma_10_30", "sma_5_20", "sma_20_50", "rsi_14", "rsi_10"] }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "Backtester: all backtests complete, backtest.complete emitted." }
        }
      ]
    }
  ]
}
