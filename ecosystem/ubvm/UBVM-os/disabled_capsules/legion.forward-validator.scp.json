{
  "scp_version":  "0.1",
  "scp_id":       "legion/forward-validator",
  "object_class": "Euclid",
  "intent":       "On backtest.complete event, run forward validation on all backtested strategies and emit validation.complete.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-05T12:00:00Z",
    "version":      "1.0.0",
    "context":      "Phase 1 trading OS — forward validation capsule.",
    "capture_mode": "conversation",
    "lineage":      []
  },
  "behaviours": [
    {
      "trigger": "on_event",
      "event":   "backtest.complete",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "ForwardValidator: running out-of-sample validation..." }
        },
        {
          "primitive": "forward_validate",
          "params": {
            "data_path": "data/test.csv",
            "strategy":  { "name": "sma_10_30", "type": "crossover", "params": { "fast": 10, "slow": 30 } }
          }
        },
        {
          "primitive": "forward_validate",
          "params": {
            "data_path": "data/test.csv",
            "strategy":  { "name": "sma_5_20", "type": "crossover", "params": { "fast": 5, "slow": 20 } }
          }
        },
        {
          "primitive": "forward_validate",
          "params": {
            "data_path": "data/test.csv",
            "strategy":  { "name": "sma_20_50", "type": "crossover", "params": { "fast": 20, "slow": 50 } }
          }
        },
        {
          "primitive": "forward_validate",
          "params": {
            "data_path": "data/test.csv",
            "strategy":  { "name": "rsi_14", "type": "rsi", "params": { "period": 14, "oversold": 30, "overbought": 70 } }
          }
        },
        {
          "primitive": "forward_validate",
          "params": {
            "data_path": "data/test.csv",
            "strategy":  { "name": "rsi_10", "type": "rsi", "params": { "period": 10, "oversold": 25, "overbought": 75 } }
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event":   "validation.complete",
            "payload": { "strategies": ["sma_10_30", "sma_5_20", "sma_20_50", "rsi_14", "rsi_10"] }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "ForwardValidator: all validations complete, validation.complete emitted." }
        }
      ]
    }
  ]
}
