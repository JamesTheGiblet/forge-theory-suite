{
  "scp_version":  "0.1",
  "scp_id":       "legion/market-watcher",
  "object_class": "Safe",
  "intent":       "Fetch live OHLCV data from Binance every 5 minutes and emit a market data updated event.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-05T12:00:00Z",
    "version":      "1.0.0",
    "context":      "Phase 1 trading OS — market data feed capsule.",
    "capture_mode": "conversation",
    "lineage":      []
  },
  "behaviours": [
    {
      "trigger":  "cron",
      "schedule": "*/5 * * * *",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "MarketWatcher: fetching BTCUSDT 1h candles..." }
        },
        {
          "primitive": "fetch_ohlcv",
          "params": {
            "symbol":   "BTCUSDT",
            "interval": "1h",
            "limit":    500,
            "append":   false
          }
        },
        {
          "primitive": "fetch_ohlcv",
          "params": {
            "symbol":   "ETHUSDT",
            "interval": "1h",
            "limit":    500,
            "append":   false
          }
        },
        {
          "primitive": "emit_event",
          "params": {
            "event":   "market.data.updated",
            "payload": { "symbols": ["BTCUSDT", "ETHUSDT"], "interval": "1h" }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "MarketWatcher: market.data.updated emitted." }
        }
      ]
    }
  ]
}
