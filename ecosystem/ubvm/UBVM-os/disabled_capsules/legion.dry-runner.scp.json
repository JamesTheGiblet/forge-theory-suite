{
  "scp_version":  "0.1",
  "scp_id":       "legion/dry-runner",
  "object_class": "Euclid",
  "intent":       "Every 5 minutes and on strategy selection: run the current best strategy against live market data and log paper-trade signals.",
  "containment": {
    "read_only":   false,
    "audit_log":   true,
    "kill_switch": true
  },
  "provenance": {
    "author":       "James / Giblets Creations",
    "agent":        "Claude Sonnet 4.6",
    "created_at":   "2026-05-05T13:00:00Z",
    "version":      "1.0.0",
    "context":      "Phase 2 trading OS — paper trading capsule.",
    "capture_mode": "conversation",
    "lineage":      ["legion/strategy-selector"]
  },
  "behaviours": [
    {
      "trigger":  "cron",
      "schedule": "*/5 * * * *",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "DryRunner: running paper trade on live data..." }
        },
        {
          "primitive": "dry_run",
          "params": {
            "symbol":   "BTCUSDT",
            "interval": "1h",
            "limit":    100
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "DryRunner: signals logged." }
        }
      ]
    },
    {
      "trigger": "on_event",
      "event":   "strategy.selected",
      "actions": [
        {
          "primitive": "log",
          "params":    { "message": "DryRunner: new strategy selected — running immediate paper trade..." }
        },
        {
          "primitive": "dry_run",
          "params": {
            "symbol":   "BTCUSDT",
            "interval": "1h",
            "limit":    100
          }
        },
        {
          "primitive": "audit_event",
          "params": {
            "event_type": "dry_run.complete",
            "data":       { "trigger": "strategy.selected", "symbol": "BTCUSDT" }
          }
        },
        {
          "primitive": "log",
          "params":    { "message": "DryRunner: post-selection paper trade complete." }
        }
      ]
    }
  ]
}
